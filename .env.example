# Public site
NEXT_PUBLIC_SITE_URL=https://bombay-bureau.vercel.app

# Sanity
SANITY_API_TOKEN=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=The Bombay Brief <onboarding@resend.dev>
# Optional: use a pre-created Resend Segment ID. If blank, the app will create/find "The Bombay Brief".
RESEND_SEGMENT_ID=
# Required only after creating the Resend webhook for /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=

# Protects the internal Newsletter Desk send endpoint.
NEWSLETTER_ADMIN_TOKEN=
